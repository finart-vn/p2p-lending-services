{
  "name": "user-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start auth-service --watch",
    "start:dev:api-gateway": "nest start api-gateway --watch",
    "start:dev:auth-service": "nest start auth-service --watch",
    "start:dev:user-service": "nest start user-service --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/user-service/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest test/e2e",
    "test:unit": "jest test/*/unit",
    "test:integration": "jest test/*/integration",
    "test:api-gateway": "jest test/api-gateway",
    "test:auth-service": "jest test/auth-service",
    "test:user-service": "jest test/user-service",
    "prisma:user:generate": "cd apps/user-service && prisma generate",
    "prisma:user:migrate": "cd apps/user-service && prisma migrate dev",
    "prisma:user:studio": "cd apps/user-service && prisma studio",
    "prisma:user:push": "cd apps/user-service && prisma db push"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.1.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.12.0",
    "@types/lodash": "^4.17.20",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.8",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.7.0",
    "prisma": "^6.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "s": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/test/**/*.spec.ts",
      "<rootDir>/test/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/",
      "\\.js$"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/apps/.*/generated/"
    ],
    "moduleNameMapper": {
      "^@p2p-lending/auth-service/(.*)$": "<rootDir>/apps/auth-service/$1",
      "^@p2p-lending/user-service/(.*)$": "<rootDir>/apps/user-service/$1",
      "^@p2p-lending/api-gateway/(.*)$": "<rootDir>/apps/api-gateway/$1",
      "^@p2p-lending/(.*)$": "<rootDir>/libs/$1",
      "^@api-gateway/(.*)$": "<rootDir>/apps/api-gateway/src/$1",
      "^@auth-service/(.*)$": "<rootDir>/apps/auth-service/src/$1",
      "^@user-service/(.*)$": "<rootDir>/apps/user-service/src/$1"
    },
    "collectCoverageFrom": [
      "apps/**/*.ts",
      "libs/**/*.ts",
      "!apps/**/*.spec.ts",
      "!apps/**/*.test.ts",
      "!apps/**/main.ts",
      "!apps/**/generated/**",
      "!libs/**/index.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "setupFilesAfterEnv": ["<rootDir>/test/setup.ts"],
    "clearMocks": true,
    "verbose": true,
    "testTimeout": 10000,
    "roots": [
      "<rootDir>/test/",
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ]
  }
}
