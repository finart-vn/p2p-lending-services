# ====================================================================================
# P2P LENDING SERVICES - ENVIRONMENT CONFIGURATION
# ====================================================================================
# Copy this file to .env and customize the values for your environment.

# ====================================================================================
# COMMON CONFIGURATION
# ====================================================================================

# Application Environment (development | staging | production | test)
NODE_ENV=development

# Service Ports
PORT=3005
PORT_API_GATEWAY=3005
PORT_AUTH_SERVICE=3007
PORT_USER_SERVICE=3006

# Logging Configuration
LOG_LEVEL=debug

# Application Version
APP_VERSION=1.0.0

# ====================================================================================
# DATABASE CONFIGURATION
# ====================================================================================

# PostgreSQL Database URL
AUTH_SERVICE_DATABASE_URL=postgresql://user:password@localhost:5432/pl-user-auth-db
# PostgreSQL Database URL
USER_SERVICE_DATABASE_URL="postgresql://user:password@localhost:5432/pl_user_db"

# Database Connection Settings
DB_ENABLE_LOGGING=false
DB_CONNECTION_TIMEOUT=10000
DB_MAX_CONNECTIONS=10

# ====================================================================================
# JWT AUTHENTICATION
# ====================================================================================

# JWT Secret Key (CRITICAL: Use a strong, unique secret in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT Token Expiration
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# JWT Issuer and Audience
JWT_ISSUER=p2p-lending
JWT_AUDIENCE=p2p-lending-users

# ====================================================================================
# REDIS CONFIGURATION
# ====================================================================================

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=admin123
REDIS_USERNAME=
REDIS_DB=0

# Redis Connection Settings
REDIS_RETRY_DELAY=100
REDIS_RETRY_ATTEMPTS=3
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_OFFLINE_QUEUE=true

# ====================================================================================
# RABBITMQ CONFIGURATION
# ====================================================================================

# RabbitMQ Connection URL
RABBITMQ_URL=amqp://admin:admin@localhost:5672

# RabbitMQ Settings
RABBITMQ_HEARTBEAT=60
RABBITMQ_CONNECTION_TIMEOUT=10000
RABBITMQ_DURABLE=true
RABBITMQ_PREFETCH_COUNT=10

# ====================================================================================
# API GATEWAY CONFIGURATION
# ====================================================================================

# Global API Prefix
GLOBAL_PREFIX=api/v1

# Request Settings
REQUEST_TIMEOUT_MS=30000
MAX_REQUEST_SIZE=10mb
ENABLE_COMPRESSION=true
ENABLE_HELMET=true
TRUSTED_PROXIES=loopback

# CORS Configuration
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=15
RATE_LIMIT_MAX=100
RATE_LIMIT_MESSAGE=Too many requests from this IP, please try again later
RATE_LIMIT_SKIP_IPS=

# Swagger Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=api-docs
SWAGGER_TITLE=P2P Lending API Gateway
SWAGGER_DESCRIPTION=API Gateway for P2P Lending Platform
SWAGGER_VERSION=1.0.0
SWAGGER_TAGS=api-gateway,authentication,users

# ====================================================================================
# AUTH SERVICE CONFIGURATION
# ====================================================================================

# JWT Secret Rotation
JWT_SECRET_ROTATION_DAYS=30

# Authentication Features
ENABLE_REFRESH_TOKENS=true
ENABLE_PASSWORD_RESET=true
ENABLE_TWO_FACTOR=false

# Security Settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
PASSWORD_RESET_EXPIRATION_HOURS=24
SESSION_TIMEOUT_MINUTES=30

# Encryption
ENCRYPTION_ALGORITHM=aes-256-gcm

# ====================================================================================
# USER SERVICE CONFIGURATION
# ====================================================================================

# Profile Management
MAX_PROFILE_IMAGE_SIZE=5242880
DEFAULT_AVATAR_URL=/assets/default-avatar.png
ENABLE_PROFILE_PICTURES=true
UPLOAD_DIRECTORY=./uploads/profiles

# User Validation
MAX_USERNAME_LENGTH=50
MIN_PASSWORD_LENGTH=8
REQUIRE_PASSWORD_COMPLEXITY=true
MAX_BIO_LENGTH=500

# Email Verification
ENABLE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_EXPIRATION_HOURS=24

# User Features
ENABLE_USER_PREFERENCES=true
PROFILE_CACHE_EXPIRATION_MINUTES=30
