# Production Environment Configuration
NODE_ENV=production
LOG_LEVEL=info

# Production Service Ports
PORT=3005
PORT_API_GATEWAY=3005
PORT_AUTH_SERVICE=3007
PORT_USER_SERVICE=3006

# Production Database (Use environment variables or secrets management)
DATABASE_URL="postgresql://prod_user:${DB_PASSWORD}@your-db-host.com:5432/p2p_lending_prod?schema=public"
DB_ENABLE_LOGGING=false
DB_CONNECTION_TIMEOUT=30000
DB_MAX_CONNECTIONS=20

# Production JWT (CRITICAL: Use strong secrets)
JWT_SECRET=${JWT_SECRET_FROM_SECRETS_MANAGER}
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=24h
JWT_SECRET_ROTATION_DAYS=30

# Production Redis
REDIS_HOST=your-redis-cluster.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_CONNECT_TIMEOUT=30000

# Production RabbitMQ
RABBITMQ_URL=amqp://prod_user:${RABBITMQ_PASSWORD}@your-rabbitmq-cluster.com:5672
RABBITMQ_CONNECTION_TIMEOUT=30000

# Production Security
ENABLE_SWAGGER=false
CORS_ENABLED=true
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_CREDENTIALS=true

# Enhanced Security for Production
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_DURATION_MINUTES=30
ENABLE_TWO_FACTOR=true
SESSION_TIMEOUT_MINUTES=15
PASSWORD_RESET_EXPIRATION_HOURS=2

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=15
RATE_LIMIT_MAX=50

# Production File Uploads
UPLOAD_DIRECTORY=/app/uploads/profiles
MAX_PROFILE_IMAGE_SIZE=5242880

# Production Optimizations
ENABLE_COMPRESSION=true
ENABLE_HELMET=true
REQUEST_TIMEOUT_MS=10000
