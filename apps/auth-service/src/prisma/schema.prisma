
generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("AUTH_SERVICE_DATABASE_URL")
}

// Core User Authentication - Tokens stored in Redis
model UserAuth {
  id           String @id @default(uuid())
  email        String @unique @db.VarChar(255)
  passwordHash String @map("password_hash") @db.VarChar(255)
  userId       String @unique @default(uuid()) @map("user_id")
  refreshToken String? @map("refresh_token") @db.VarChar(255)
  // Basic Security
  emailVerified         Boolean   @default(false) @map("email_verified")
  emailVerifiedAt       DateTime? @map("email_verified_at")
  isActive              Boolean   @default(true) @map("is_active")
  failedLoginAttempts   Int       @default(0) @map("failed_login_attempts")
  lastFailedLoginAt     DateTime? @map("last_failed_login_at")
  lastSuccessfulLoginAt DateTime? @map("last_successful_login_at")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  auditLogs AuthAuditLog[]

  @@index([email])
  @@index([userId])
  @@index([isActive])
  @@index([emailVerified])
  @@map("users_auth")
}

// Basic Audit Logging for Security
model AuthAuditLog {
  id         String  @id @default(uuid())
  userAuthId String? @map("user_auth_id")

  // Event Information
  eventType String  @map("event_type") @db.VarChar(50) // "login", "logout", "register", "password_change"
  success   Boolean @map("success")
  message   String? @map("message") @db.VarChar(500)

  // Request Information
  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.Text

  // Timestamp
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  userAuth UserAuth? @relation(fields: [userAuthId], references: [id], onDelete: SetNull)

  @@index([userAuthId])
  @@index([eventType])
  @@index([createdAt])
  @@index([success])
  @@map("auth_audit_logs")
}

// Optional: Simple Rate Limiting (Redis is better for this)
model RateLimit {
  id          String   @id @default(uuid())
  identifier  String   @map("identifier") @db.VarChar(255) // IP address or user ID
  action      String   @map("action") @db.VarChar(50) // "login", "register", "reset_password"
  count       Int      @default(1) @map("count")
  windowStart DateTime @map("window_start")
  expiresAt   DateTime @map("expires_at")

  @@unique([identifier, action, windowStart])
  @@index([identifier, action])
  @@index([expiresAt])
  @@map("rate_limits")
}
