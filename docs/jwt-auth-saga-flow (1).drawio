        <mxCell id="arrow1" value="POST / register" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;strokeColor=#e74c3c;strokeWidth=2;" parent="1" source="web-app" target="api-gateway" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
