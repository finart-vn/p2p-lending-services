          <mxGeometry x="-90" y="420" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="auth-service" value="&lt;b&gt;Auth Service&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;• JWT Generation&lt;br&gt;• Saga Orchestrator&lt;/div&gt;&lt;div&gt;Hash password&lt;/div&gt;&lt;div&gt;stores auth record&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#60a917;strokeColor=#2D7600;fontSize=11;fontColor=#ffffff;" parent="1" vertex="1">
          <mxGeometry x="1040" y="570" width="140" height="90" as="geometry" />
