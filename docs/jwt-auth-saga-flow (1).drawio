        <mxCell id="user-service" value="User Service&#xa;• Profile Management&#xa;• Event Handling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0050ef;strokeColor=#001DBC;fontSize=11;fontColor=#ffffff;" parent="1" vertex="1">
          <mxGeometry x="1020" y="470" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="notification-service" value="Notification Service&#xa;• Welcome Emails&#xa;• SMS Alerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#76608a;strokeColor=#432D57;fontSize=11;fontColor=#ffffff;" parent="1" vertex="1">
          <mxGeometry x="970" y="280" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="flow-info" value="REGISTRATION SAGA FLOW&#xa;&#xa;1. POST /register → Gateway&#xa;2. Hash password + store auth&#xa;3. Emit: CreateUserProfile&#xa;4. User Service creates profile&#xa;5. Emit: UserCreated&#xa;6. Generate JWT tokens&#xa;7. Return tokens to client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#6c757d;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1130" y="130" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="jwt-info" value="JWT TOKENS&#xa;&#xa;Access Token: 15 minutes&#xa;Refresh Token: 7 days&#xa;&#xa;Payload: userId, email, role&#xa;Storage: Hashed in Auth DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3cd;strokeColor=#856404;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1160" y="245" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="events-info" value="KEY EVENTS&#xa;&#xa;• CreateUserProfile&#xa;• UserCreated&#xa;• UserProfileCreationFailed&#xa;• SendWelcomeEmail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1ecf1;strokeColor=#0c5460;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1170" y="400" width="220" height="100" as="geometry" />
