        <mxCell id="idx_label1" value="&lt;b&gt;Indexes:&lt;/b&gt;&lt;br/&gt;• users: email, status, created_at&lt;br/&gt;• kyc: user_id, status&lt;br/&gt;• credit_scores: user_id, calculated_at&lt;br/&gt;• loans: borrower_id, status, listing_date&lt;br/&gt;• investments: lender_id, loan_id, status&lt;br/&gt;• repayment_schedules: loan_id, due_date, status&lt;br/&gt;• payments: loan_id, schedule_id, payer_id, status&lt;br/&gt;• notifications: user_id, type, status, created_at&lt;br/&gt;• activity_logs: user_id, action, created_at&lt;br/&gt;• analytics_reports: generated_by, report_type, generated_at" style="align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" parent="1" vertex="1">
