        </mxCell>

        <!-- Investment Service -->
        <mxCell id="investmentService" value="Investment Service&#10;PostgreSQL" style="shape=rectangle;rounded=1;fillColor=#FCE4D6;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="260" y="220" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- Repayment Service -->
        <mxCell id="repaymentService" value="Repayment Service&#10;PostgreSQL" style="shape=rectangle;rounded=1;fillColor=#FCE4D6;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="460" y="220" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- Notification Service -->
        <mxCell id="notificationService" value="Notification Service&#10;MongoDB" style="shape=rectangle;rounded=1;fillColor=#D9EAD3;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- Analytics Service -->
        <mxCell id="analyticsService" value="Analytics Service&#10;PostgreSQL" style="shape=rectangle;rounded=1;fillColor=#D9EAD3;strokeColor=#000000;" vertex="1" parent="1">
