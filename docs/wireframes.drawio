        <!-- RabbitMQ -->
        <mxCell id="rabbitMQ" value="RabbitMQ Bus" style="shape=cylinder;whiteSpace=wrap;fillColor=#F4CCCC;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="460" y="320" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- Lines from API Gateway -->
        <mxCell style="endArrow=block;" edge="1" parent="1" source="apiGateway" target="authService" />
        <mxCell style="endArrow=block;" edge="1" parent="1" source="apiGateway" target="userService" />
        <mxCell style="endArrow=block;" edge="1" parent="1" source="apiGateway" target="kycService" />
        <mxCell style="endArrow=block;" edge="1" parent="1" source="apiGateway" target="loanService" />
