<mxfile host="app.diagrams.net">
  <diagram name="Microservice Architecture" id="bXtU9JGjxD4ZZKzKvpmx">
    <mxGraphModel dx="1350" dy="1002" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- API Gateway -->
        <mxCell id="apiGateway" value="API Gateway&#10;NestJS" style="shape=rectangle;whiteSpace=wrap;rounded=1;fillColor=#DDEBF7;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- Auth Service -->
        <mxCell id="authService" value="Auth Service&#10;PostgreSQL" style="shape=rectangle;rounded=1;fillColor=#FFF2CC;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- User Service -->
        <mxCell id="userService" value="User Service&#10;PostgreSQL" style="shape=rectangle;rounded=1;fillColor=#FFF2CC;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="260" y="120" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- KYC Service -->
        <mxCell id="kycService" value="KYC Service&#10;MongoDB" style="shape=rectangle;rounded=1;fillColor=#E2EFDA;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="460" y="120" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- Loan Service -->
        <mxCell id="loanService" value="Loan Service&#10;PostgreSQL" style="shape=rectangle;rounded=1;fillColor=#FCE4D6;strokeColor=#000000;" vertex="1" parent="1">
