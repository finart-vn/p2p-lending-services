        <mxCell style="endArrow=block;dashed=1;" edge="1" parent="1" source="repaymentService" target="rabbitMQ"/>
        <mxCell style="endArrow=block;dashed=1;" edge="1" parent="1" source="notificationService" target="rabbitMQ"/>
        <mxCell style="endArrow=block;dashed=1;" edge="1" parent="1" source="analyticsService" target="rabbitMQ"/>

