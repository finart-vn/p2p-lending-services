        <mxCell style="endArrow=block;" edge="1" parent="1" source="apiGateway" target="repaymentService" />

        <!-- All services to RabbitMQ -->
        <mxCell style="endArrow=block;dashed=1;" edge="1" parent="1" source="authService" target="rabbitMQ"/>
        <mxCell style="endArrow=block;dashed=1;" edge="1" parent="1" source="userService" target="rabbitMQ"/>
        <mxCell style="endArrow=block;dashed=1;" edge="1" parent="1" source="kycService" target="rabbitMQ"/>
        <mxCell style="endArrow=block;dashed=1;" edge="1" parent="1" source="loanService" target="rabbitMQ"/>
