# Development Environment Configuration
NODE_ENV=development
LOG_LEVEL=debug

# Development Service Ports
PORT=3005
PORT_API_GATEWAY=3005
PORT_AUTH_SERVICE=3007
PORT_USER_SERVICE=3006

# Development Database
DATABASE_URL="postgresql://dev_user:dev_password@localhost:5432/p2p_lending_dev?schema=public"
DB_ENABLE_LOGGING=true

# Development JWT (NOT FOR PRODUCTION)
JWT_SECRET=development-jwt-secret-key-for-local-testing-only
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Local Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=admin123

# Local RabbitMQ
RABBITMQ_URL=amqp://admin:admin@localhost:5672

# Development Features
ENABLE_SWAGGER=true
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080
CORS_CREDENTIALS=true

# Relaxed Security for Development
MAX_LOGIN_ATTEMPTS=10
LOCKOUT_DURATION_MINUTES=5
ENABLE_TWO_FACTOR=false

# Development File Uploads
UPLOAD_DIRECTORY=./dev-uploads/profiles
MAX_PROFILE_IMAGE_SIZE=10485760
